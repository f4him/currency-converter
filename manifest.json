{
  "manifest_version": 3,
  "name": "Currency Converter",
  "version": "2.0.1",
  "description": "Hover over prices to see converted currency values and use a popup converter with live exchange rates.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Currency Converter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "currencies.js",
        "sites/amazon.js",
        "sites/aliexpress.js",
        "sites/ebay.js",
        "sites/walmart.js",
        "sites/temu.js",
        "sites/generic.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
